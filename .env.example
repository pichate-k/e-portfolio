# PostgreSQL Database URL
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pichatek_db?schema=public"

# Vercel / Cloud Database example (Neon / Supabase / Neon Serverless):
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
# DIRECT_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# JWT Secret for Admin Authentication Session
JWT_SECRET="replace-with-a-random-32-character-secret-key"

# Optional App URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
